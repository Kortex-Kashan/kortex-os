root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{ts,tsx,js,jsx,json,yml,yaml,html,css}]
indent_style = space
indent_size = 2

[*.{ts,tsx}]
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
