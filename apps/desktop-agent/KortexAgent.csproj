<Project Sdk="Microsoft.NET.Sdk">

  <!--
    KORTEX Windows Desktop Agent (Phase 5/6).

    Phase 5: establishes machine identity, enrolls once against the backend
    over trusted HTTPS, and maintains an mTLS gRPC session. Phase 6 (this
    milestone) adds the one thing Phase 5 deliberately withheld: execution of
    a finite, explicitly typed set of UI-automation commands the Gateway
    pushes down that same session — `DesktopAutomationHandler`, using
    FlaUI/UI Automation (UIA3). There is still no browser driver, no shell,
    no arbitrary process launching, and no generic script/command execution
    anywhere in this project — see `DesktopAutomationHandler`'s own docstring
    for the allow-list and deterministic-targeting design that keeps it that
    way.

    Windows-only by construction — the agent's security model depends on the
    Windows Registry for the Machine Installation ID and on Windows CNG for a
    non-exportable private key, neither of which has a cross-platform
    equivalent that preserves the same guarantees, and FlaUI/UI Automation
    itself is a Windows-only accessibility API.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Kortex.Agent</RootNamespace>
    <AssemblyName>KortexAgent</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" Version="2.67.0" />
    <PackageReference Include="Google.Protobuf" Version="3.29.3" />
    <PackageReference Include="Grpc.Tools" Version="2.69.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <PackageReference Include="FlaUI.Core" Version="5.0.0" />
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="protos\agent.proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- Adversarial matrix test 23 exercises `NonExportableKey` directly. -->
    <InternalsVisibleTo Include="KortexAgent.Tests" />
  </ItemGroup>

  <!--
    The SDK-style default compile glob is `**/*.cs` under the project
    directory, which would otherwise also pick up tests\*.cs, a separate
    xunit test project nested under this one for convenience of co-location:
    Excluding it here is what makes "one project directory, two .csproj
    files" work at all: without it, this project fails to compile because it
    has no xunit reference, and the test project would separately duplicate
    every application source file.
  -->
  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <None Remove="tests\**\*" />
    <Content Remove="tests\**\*" />
    <EmbeddedResource Remove="tests\**\*" />
    <!-- Same reason: `testapp\` is a second nested project directory
         (the Phase 7 E2E fixture, `KortexAutomationTestApp.csproj`),
         co-located here for convenience the same way `tests\` is. -->
    <Compile Remove="testapp\**\*.cs" />
    <None Remove="testapp\**\*" />
    <Content Remove="testapp\**\*" />
    <EmbeddedResource Remove="testapp\**\*" />
  </ItemGroup>

</Project>
