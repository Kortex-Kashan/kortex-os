{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KORTEX Desktop",
  "version": "0.1.0",
  "identifier": "com.kortex.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KORTEX Desktop",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["msi", "nsis"],
    "resources": {
      "../../../dist/kortex-backend": "kortex-backend"
    },
    "windows": {
      "wix": {
        "upgradeCode": "71b2a7f2-94c1-4a51-8925-4d22890d6de3"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
